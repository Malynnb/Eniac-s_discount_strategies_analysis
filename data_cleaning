import pandas as pd

# =========================
# LOAD DATA
# =========================

orders = pd.read_csv(base_path + "orders.csv")
orderlines = pd.read_csv(base_path + "orderlines.csv")
products = pd.read_csv(base_path + "products.csv")
brands = pd.read_csv(base_path + "brands.csv")

# Backups
orders_backup = orders.copy()
orderlines_backup = orderlines.copy()
products_backup = products.copy()
brands_backup = brands.copy()

# =========================
# CLEAN PRODUCTS
# =========================

product_df = products.copy()

# Remove duplicate SKUs
product_df = product_df.drop_duplicates(subset="sku")

# Drop unused columns
product_df = product_df.drop(columns=["promo_price", "in_stock"])

# Remove invalid price values (e.g. "..")
product_df = product_df[
    ~product_df["price"].astype(str).str.contains(r"\.\.")
]

# Convert to numeric
product_df["price"] = pd.to_numeric(
    product_df["price"],
    errors="coerce"
)

# Remove missing values
product_df = product_df.dropna()

# Keep highest-priced duplicate product names
product_df = (
    product_df
    .sort_values("price", ascending=False)
    .drop_duplicates(subset="name", keep="first")
)

print("Products shape:", product_df.shape)

# =========================
# CLEAN ORDERS
# =========================

order_df = orders.copy()

# Keep completed orders only
order_df = order_df[
    order_df["state"] == "Completed"
]

# Remove state column
order_df = order_df.drop(columns=["state"])

# Remove missing values
order_df = order_df.dropna()

print("Orders shape:", order_df.shape)

# =========================
# CLEAN ORDERLINES
# =========================

orderline_df = orderlines.copy()

# Drop unnecessary column
orderline_df = orderline_df.drop(columns=["product_id"])

# Convert price to numeric
orderline_df["unit_price"] = pd.to_numeric(
    orderline_df["unit_price"],
    errors="coerce"
)

# Remove invalid prices
orderline_df = orderline_df.dropna(
    subset=["unit_price"]
)

# Remove invalid quantities/prices
orderline_df = orderline_df[
    (orderline_df["unit_price"] > 0)
    & (orderline_df["product_quantity"] > 0)
]

# Rename columns
orderline_df = orderline_df.rename(
    columns={
        "id_order": "order_id",
        "product_quantity": "quantity"
    }
)

# Convert date
orderline_df["date"] = pd.to_datetime(
    orderline_df["date"]
)

print("Orderlines shape:", orderline_df.shape)

# =========================
# VALIDATE RELATIONSHIPS
# =========================

# Keep only orderlines with valid completed orders
orderline_df = orderline_df[
    orderline_df["order_id"].isin(
        order_df["order_id"]
    )
]

# Keep only orders with orderlines
order_df = order_df[
    order_df["order_id"].isin(
        orderline_df["order_id"]
    )
]

print("Validated orders:", order_df.shape)
print("Validated orderlines:", orderline_df.shape)

# =========================
# MERGE DATA
# =========================

sales_df = orderline_df.merge(
    product_df[["sku", "price"]],
    on="sku",
    how="left"
)

print("Merged dataset:", sales_df.shape)
